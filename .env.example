# Server
PORT=3000
HOST=0.0.0.0

# Twitch
TWITCH_CHANNEL=your_channel_name
TWITCH_USERNAME=your_twitch_username
TWITCH_OAUTH_TOKEN=your_twitch_oauth_token

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key
# One of the following is required to find the live stream:
YOUTUBE_CHANNEL_ID=your_youtube_channel_id
YOUTUBE_HANDLE=your_youtube_handle
# Optional (if you want to force a specific chat ID, otherwise it is auto-detected):
YOUTUBE_LIVE_CHAT_ID=

# Kick
KICK_CHANNEL=your_kick_channel_name
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# TikTok
TIKTOK_USERNAME=your_tiktok_username

# Overlay theme
OVERLAY_TITLE=Chat
THEME_ACCENT=#8b5cf6
THEME_TEXT=#ffffff
THEME_BG=rgba(17,17,23,0.35)
THEME_CARD_BG=rgba(0,0,0,0.35)
THEME_BORDER=rgba(255,255,255,0.12)
THEME_FONT_FAMILY=Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial

# Behavior
MAX_MESSAGE_LENGTH=350
BAD_WORDS=badword1,badword2
SHOW_PLATFORM_TAG=true
